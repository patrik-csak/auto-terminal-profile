{
  "name": "auto-terminal-profile",
  "version": "8.2.2",
  "description": "Automatically switch macOS Terminal profile when system dark / light mode changes",
  "license": "MIT",
  "repository": "github:patrik-csak/auto-terminal-profile",
  "author": "Patrik Csak <p@trikcsak.com> (https://patrikcsak.com)",
  "type": "module",
  "bin": {
    "auto-terminal-profile": "./distribution/cli.js"
  },
  "engines": {
    "node": "22 - 26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22 - 26"
    }
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "prebuild": "rm -rf distribution",
    "build": "tsc",
    "postbuild": "chmod u+x distribution/cli.js",
    "lint": "tsc --noEmit && tsc --project test/tsconfig.json && eslint --cache --concurrency=auto && knip",
    "prepack": "npm run build",
    "test": "node --experimental-test-module-mocks --test",
    "test:coverage": "npm run test -- --experimental-test-coverage"
  },
  "files": [
    "distribution"
  ],
  "keywords": [
    "macos",
    "terminal",
    "light mode",
    "dark mode",
    "profile"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "conf": "^16.0.0",
    "consola": "^3.4.2",
    "dark-mode": "^5.0.0",
    "exit-hook": "^5.1.0",
    "mac-terminal": "^6.1.0"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.20.5",
    "eslint": "^10.8.0",
    "eslint-config-xo": "^6.0.0",
    "knip": "^6.29.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
