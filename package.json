{
  "name": "auto-terminal-profile",
  "version": "8.2.0",
  "description": "Automatically switch macOS Terminal profile when system dark / light mode changes",
  "license": "MIT",
  "repository": "github:patrik-csak/auto-terminal-profile",
  "author": "Patrik Csak <p@trikcsak.com> (https://patrikcsak.com)",
  "type": "module",
  "imports": {
    "#*": "./source/*/index.js",
    "#package-json": "./package.json"
  },
  "bin": {
    "auto-terminal-profile": "./source/cli.js"
  },
  "engines": {
    "node": "22 - 26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22 - 26"
    }
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "lint": "eslint && knip",
    "test": "node --experimental-test-module-mocks --test",
    "test:coverage": "npm run test -- --experimental-test-coverage"
  },
  "files": [
    "source"
  ],
  "keywords": [
    "macos",
    "terminal",
    "light mode",
    "dark mode",
    "profile"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "conf": "^15.0.2",
    "consola": "^3.4.2",
    "dark-mode": "^5.0.0",
    "mac-terminal": "^6.1.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-config-xo": "^5.0.0",
    "knip": "^6.29.0"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
